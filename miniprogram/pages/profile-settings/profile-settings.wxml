<view class="settings-card">
  <text class="settings-title">{{title}}</text>
  <text class="settings-text">{{description}}</text>

  <view class="doc-tabs">
    <view class="doc-tab {{docType === 'privacy' ? 'active' : ''}}" data-doc="privacy" bindtap="switchDoc">隐私政策</view>
    <view class="doc-tab {{docType === 'agreement' ? 'active' : ''}}" data-doc="agreement" bindtap="switchDoc">用户协议</view>
  </view>

  <view class="doc-content">
    <view class="doc-section" wx:for="{{sections}}" wx:key="title">
      <text class="doc-section-title">{{item.title}}</text>
      <text class="doc-section-text">{{item.text}}</text>
    </view>
    <text class="doc-note">本政策自 2026 年 10 月 10 日起生效。如有隐私相关问题，请通过小程序右上角“…”中的“反馈与投诉”提交。</text>
  </view>
</view>