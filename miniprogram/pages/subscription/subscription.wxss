.sub-summary { margin: 24rpx; padding: 36rpx; border-radius: var(--radius-lg); background: #105666; color: #fff; border: var(--stroke-width) solid var(--stroke); box-shadow: var(--shadow-float); }
.sum-title { font-size: 25rpx; opacity: .9; }
.sum-main { margin-top: 14rpx; display: flex; align-items: baseline; }
.sum-num { font-size: 58rpx; font-weight: 700; }
.sum-unit { margin-left: 8rpx; font-size: 24rpx; opacity: .85; }
.sum-sub { margin-top: 10rpx; font-size: 23rpx; opacity: .82; }
.scan-card { position: relative; overflow: hidden; min-height: 150rpx; display: flex; align-items: center; margin: 0 24rpx 24rpx; padding: 26rpx 150rpx 26rpx 30rpx; background: var(--primary); color: #fff; border: var(--stroke-width) solid var(--stroke); border-radius: var(--radius-md); box-shadow: 0 6rpx 0 var(--stroke); }
.scan-ico { width: 72rpx; height: 72rpx; display: flex; align-items: center; justify-content: center; border-radius: 22rpx; background: rgba(255,255,255,.2); margin-right: 20rpx; }
.scan-body { flex: 1; display: flex; flex-direction: column; }
.scan-title { font-size: 29rpx; font-weight: 700; }
.scan-sub { margin-top: 6rpx; font-size: 22rpx; color: rgba(255,255,255,.85); }
.sub-list { padding: 8rpx 28rpx; }
.row { position: relative; display: flex; align-items: center; padding: 26rpx 0; border-bottom: 1rpx solid var(--divider); }
.row:last-child { border-bottom: none; }
.row-main { flex: 1; min-width: 0; }
.row-top { display: flex; justify-content: space-between; gap: 18rpx; }
.row-name { font-size: 30rpx; font-weight: 700; color: var(--text-main); }
.row-amount { font-size: 25rpx; font-weight: 700; color: var(--primary-mid); white-space: nowrap; }
.row-meta { margin-top: 8rpx; font-size: 22rpx; color: var(--text-light); }
.row-note { margin-top: 8rpx; font-size: 24rpx; color: var(--text-sub); }
.cancel-btn { margin-left: 20rpx; padding: 10rpx 20rpx; border-radius: 999rpx; background: #fff; border: 2rpx solid #D9534F; color: #D9534F; font-size: 22rpx; }
.empty { display: flex; flex-direction: column; align-items: center; padding: 80rpx 0; }
.empty-text { margin-top: 18rpx; color: var(--text-light); font-size: 24rpx; }
.add-entry { margin: 0 24rpx 24rpx; height: 82rpx; line-height: 82rpx; text-align: center; background: var(--primary); color: #fff; border: var(--stroke-width) solid var(--stroke); border-radius: 999rpx; box-shadow: 0 7rpx 0 var(--stroke); font-weight: 700; }
.loading { padding: 30rpx 0; text-align: center; color: var(--text-light); font-size: 24rpx; }

.sub-list {
  position: relative;
  overflow: hidden;
}
.decor {
  position: absolute;
  pointer-events: none;
  z-index: 0;
}
.decor-cycling {
  right: -4rpx;
  bottom: -24rpx;
  width: 142rpx;
  height: 150rpx;
  opacity: .95;
}
.scan-ico, .scan-body { position: relative; z-index: 2; }
.row, .empty, .loading { position: relative; z-index: 2; }

.history-toggle { margin: 0 24rpx 18rpx; padding: 18rpx; text-align: center; border-radius: 999rpx; background: var(--cream); border: var(--stroke-width) solid var(--stroke); color: var(--primary-mid); font-size: 24rpx; font-weight: 700; }
.history-list { padding: 12rpx 28rpx; }
.history-row { display: flex; justify-content: space-between; gap: 14rpx; padding: 20rpx 0; border-bottom: 1rpx solid var(--divider); font-size: 23rpx; color: var(--text-sub); }
.history-row:last-child { border-bottom: none; }
.history-status { color: #D9534F; }

.row-actions { display: flex; flex-direction: column; gap: 10rpx; margin-left: 16rpx; }
.renew-btn { padding: 10rpx 20rpx; border-radius: 999rpx; background: var(--primary); color: #fff; border: 2rpx solid var(--stroke); font-size: 22rpx; text-align: center; }
.cancel-btn { margin-left: 0; }
