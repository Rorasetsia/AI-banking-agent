.diary-card { position: relative; width: calc(100% - 48rpx) !important; margin: 24rpx !important; padding: 30rpx; box-sizing: border-box; }
.read-head { position: relative; z-index: 2; text-align: center; padding: 6rpx 90rpx 22rpx; border-bottom: 2rpx solid var(--divider); }
.read-decor { position: absolute; right: 4rpx; top: 4rpx; width: 118rpx; height: 138rpx; opacity: .35; pointer-events: none; }
.read-title { display: block; font-size: 36rpx; font-weight: 700; color: var(--text-main); }
.date-line { display: block; margin-top: 10rpx; color: var(--text-light); font-size: 23rpx; }
.read-content { max-height: 560rpx; padding: 26rpx; background: var(--cream); border: var(--stroke-width) solid var(--stroke); border-radius: var(--radius-md); font-size: 28rpx; line-height: 1.75; color: var(--text-main); box-sizing: border-box; }
.read-content.expanded { max-height: 1100rpx; }
.expand-toggle { margin-top: 14rpx; text-align: center; color: var(--primary-mid); font-size: 24rpx; font-weight: 700; }
.read-actions { display: flex; justify-content: center; align-items: center; gap: 18rpx; margin: 24rpx; }
.read-actions .btn { width: 260rpx; flex: 0 0 260rpx; }
.btn { height: 78rpx; display: flex; align-items: center; justify-content: center; padding: 0; border-radius: 999rpx; border: var(--stroke-width) solid var(--stroke); font-size: 28rpx; font-weight: 700; box-sizing: border-box; }
.btn.primary { background: var(--primary); color: #fff; }
.btn.ghost { background: #fff; color: var(--primary-mid); }
.btn.small { height: 68rpx; font-size: 24rpx; }
.title-input { height: 82rpx; line-height: 82rpx; padding: 0 6rpx; border-bottom: 2rpx solid var(--divider); font-size: 34rpx; font-weight: 700; color: var(--text-main); }
.toolbar { display: flex; flex-wrap: wrap; gap: 12rpx; margin: 20rpx 0; }
.tool-btn { min-width: 62rpx; height: 58rpx; padding: 0 16rpx; display: flex; align-items: center; justify-content: center; border-radius: 16rpx; background: #fff; border: 2rpx solid var(--stroke); color: var(--primary-mid); font-size: 23rpx; }
.tool-bold { font-size: 30rpx; font-weight: 700; }
.polish-btn { background: var(--primary-light); color: var(--text-main); font-weight: 700; }
.editor { width: 100%; min-height: 620rpx; padding: 22rpx; background: var(--cream); border: var(--stroke-width) solid var(--stroke); border-radius: var(--radius-md); box-sizing: border-box; font-size: 28rpx; line-height: 1.7; }
.edit-footer { display: flex; align-items: center; justify-content: flex-end; gap: 14rpx; margin-top: 20rpx; }
.trash-btn { width: 56rpx; height: 56rpx; display: flex; align-items: center; justify-content: center; margin-right: auto; border-radius: 50%; background: #fff; border: 2rpx solid rgba(217,83,79,.5); font-size: 25rpx; }
.edit-tip { margin-top: 16rpx; color: var(--text-light); font-size: 21rpx; line-height: 1.5; }
.empty, .loading { padding: 120rpx 30rpx; text-align: center; color: var(--text-light); font-size: 25rpx; }
.empty-btn { display: flex; align-items: center; justify-content: center; padding: 0; width: 280rpx; height: 72rpx; margin-top: 28rpx; line-height: 72rpx; border-radius: 999rpx; background: var(--primary); color: #fff; border: var(--stroke-width) solid var(--stroke); font-size: 25rpx; font-weight: 700; }
.polish-mask { position: fixed; inset: 0; z-index: 1000; background: rgba(10,51,35,.45); display: flex; align-items: center; justify-content: center; padding: 30rpx; }
.polish-card { width: 100%; max-height: 90vh; padding: 28rpx; background: #fff; border: var(--stroke-width) solid var(--stroke); border-radius: var(--radius-lg); box-sizing: border-box; }
.polish-title { display: block; text-align: center; font-size: 32rpx; font-weight: 700; color: var(--text-main); }
.polish-label { display: block; margin: 20rpx 0 8rpx; font-size: 23rpx; font-weight: 700; color: var(--primary-mid); }
.polish-box { height: 220rpx; padding: 18rpx; background: var(--cream); border: 2rpx solid var(--divider); border-radius: 18rpx; font-size: 25rpx; line-height: 1.6; color: var(--text-main); box-sizing: border-box; }
.polish-box.polished { background: var(--primary-light); }
.polish-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; margin-top: 22rpx; }

.color-row { display: flex; flex-wrap: wrap; gap: 18rpx; margin: 4rpx 0 18rpx; padding: 14rpx 18rpx; background: #fff; border: 2rpx solid var(--divider); border-radius: 18rpx; }
.color-dot { width: 44rpx; height: 44rpx; border-radius: 50%; border: 3rpx solid #fff; box-shadow: 0 0 0 2rpx rgba(10,51,35,.35); box-sizing: border-box; }
