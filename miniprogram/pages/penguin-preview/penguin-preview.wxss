.preview-page {
  min-height: 100vh;
  padding: 80rpx 40rpx 60rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #f6f1e8;
}
.stage {
  width: 560rpx;
  height: 650rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.state-name {
  margin-top: 8rpx;
  color: #8a8075;
  font-size: 24rpx;
  letter-spacing: 2rpx;
}
.actions {
  display: flex;
  gap: 18rpx;
  margin-top: 40rpx;
}
.action {
  min-width: 150rpx;
  margin: 0;
  border-radius: 999rpx;
  border: 2rpx solid #1f2528;
  background: #fff;
  color: #1f2528;
  font-size: 26rpx;
  line-height: 76rpx;
  padding: 0 28rpx;
}
.action.primary {
  background: #1f2528;
  color: #fff;
}
