.calendar-card { margin: 24rpx; padding: 28rpx 20rpx; background: #fff; border: var(--stroke-width) solid var(--stroke); border-radius: var(--radius-lg); box-shadow: var(--shadow-card); }
.calendar-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx; }
.month-title { font-size: 32rpx; font-weight: 700; color: var(--text-main); }
.nav-btn { width: 64rpx; height: 64rpx; line-height: 58rpx; text-align: center; border-radius: 50%; background: var(--cream); border: var(--stroke-width) solid var(--stroke); font-size: 42rpx; color: var(--primary-mid); }
.week-row { display: grid; grid-template-columns: repeat(7, 1fr); gap: 10rpx; margin-bottom: 10rpx; text-align: center; color: var(--text-sub); font-size: 22rpx; }
.day-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 10rpx; }
.day-cell { height: 74rpx; display: flex; align-items: center; justify-content: center; border-radius: 20rpx; background: var(--cream); border: 2rpx solid transparent; color: var(--text-main); font-size: 26rpx; }
.day-cell:active { background: var(--primary-light); border-color: var(--stroke); }
.day-cell.blank { background: transparent; }
.tip { margin: 20rpx 32rpx; color: var(--text-light); text-align: center; font-size: 23rpx; }

.day-cell.future { background: #f1f0ed; color: #b8b8b8; }
.day-cell.future:active { background: #f1f0ed; border-color: transparent; }
