<view class="tabs"><view class="tab {{tab === 'budget' ? 'active' : ''}}" data-tab="budget" bindtap="switchTab">预算设置</view><view class="tab {{tab === 'goal' ? 'active' : ''}}" data-tab="goal" bindtap="switchTab">攒钱目标</view></view>
<block wx:if="{{tab === 'budget'}}">
  <view class="card total-card"><view class="section-title">总预算 · {{month}}</view><view class="total-row"><view class="total-item"><text class="label">月预算</text><text class="value">¥{{total.monthlyAmount || '未设置'}}</text><view class="small-btn tap" data-period="month" bindtap="editTotal">设置月预算</view></view><view class="total-item"><text class="label">日预算</text><text class="value">¥{{total.dailyAmount || '未设置'}}</text><view class="small-btn tap" data-period="day" bindtap="editTotal">设置日预算</view></view></view><view class="hint">设置任一项后，会按 {{month}} 的实际天数自动推算另一项。</view></view>
  <view class="card category-card"><view class="section-head"><text class="section-title">分类细预算</text><text class="add-link" bindtap="addCategory">＋ 添加分类</text></view><view class="category-row" wx:for="{{categories}}" wx:key="_id"><view><text class="category-name">{{item.category}}</text><text class="category-meta">月 ¥{{item.monthlyText}} · 日 ¥{{item.dailyText}}</text></view><view class="actions"><text class="link" data-index="{{index}}" bindtap="editCategory">编辑</text><text class="link danger" data-index="{{index}}" bindtap="deleteCategory">删除</text></view></view><view wx:if="{{categories.length === 0}}" class="empty">暂无分类预算</view></view>
</block>
<block wx:else>
  <view class="card goal-card"><view class="section-head"><text class="section-title">我的攒钱目标</text><text class="add-link" bindtap="addGoal">＋ 新建目标</text></view><view class="goal-item" wx:for="{{goals}}" wx:key="_id"><view class="goal-top"><text class="goal-name">{{item.name}}</text><text class="goal-money">¥{{item.savedAmount}} / ¥{{item.targetAmount}}</text></view><view class="progress"><view class="progress-inner" style="width: {{item.progress}}%"></view></view><text class="goal-meta">{{item.deadline || '未设置截止日期'}} · 已完成 {{item.progress}}%</text><view class="actions"><text class="link" data-index="{{index}}" bindtap="editGoal">编辑</text><text class="link danger" data-index="{{index}}" bindtap="deleteGoal">删除</text></view></view><view wx:if="{{goals.length === 0}}" class="empty">还没有攒钱目标</view></view>
</block>
