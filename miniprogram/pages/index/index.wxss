.hero { background: linear-gradient(135deg, #3a7afe, #6ea8ff); color:#fff; }
.hero-title { font-size: 26rpx; opacity:.9; }
.hero-amount { display:flex; gap: 60rpx; margin-top: 12rpx; }
.amount-item { display:flex; flex-direction:column; }
.amount-item .num { font-size: 48rpx; font-weight:600; }
.amount-item .label { font-size: 24rpx; opacity:.85; }
.sec-title { font-size: 30rpx; font-weight:600; margin-bottom: 16rpx; }
.mood-row { display:flex; align-items:center; margin-bottom: 12rpx; }
.mood-period { width: 48rpx; font-size: 24rpx; color: var(--text-light); }
.mood-tags { display:flex; flex-wrap:wrap; gap: 12rpx; }
.mood-tag { padding: 8rpx 20rpx; border-radius: 28rpx; background:#f2f3f5; font-size:24rpx; color:var(--text-sub); }
.mood-tag.active { background: var(--primary-light); color: var(--primary); }
.quick-grid { display:flex; gap: 24rpx; }
.quick { flex:1; display:flex; flex-direction:column; align-items:center; padding: 24rpx 0; background:#f7f8fa; border-radius: 12rpx; font-size:26rpx; }
.q-ico { font-size: 44rpx; margin-bottom: 8rpx; }