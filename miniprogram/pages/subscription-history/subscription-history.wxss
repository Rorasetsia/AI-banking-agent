.history-card { padding: 10rpx 28rpx; }
.history-row { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; padding: 26rpx 0; border-bottom: 1rpx solid var(--divider); }
.history-row:last-child { border-bottom: none; }
.row-main { flex: 1; display: flex; flex-direction: column; }
.row-name { font-size: 30rpx; font-weight: 700; color: var(--text-main); }
.row-meta { margin-top: 7rpx; font-size: 21rpx; color: var(--text-light); }
.row-status { color: #D9534F; font-size: 23rpx; }
.empty, .loading { padding: 80rpx 0; text-align: center; color: var(--text-light); font-size: 24rpx; }
