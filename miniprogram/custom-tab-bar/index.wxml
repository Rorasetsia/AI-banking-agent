<view class="tab-bar">
  <view
    class="tab-item {{selected == index ? 'active' : ''}}"
    wx:for="{{list}}"
    wx:key="pagePath"
    data-index="{{index}}"
    data-path="{{item.pagePath}}"
    bindtap="switchTab"
  >
    <view class="tab-icon">
      <view class="iico iico-{{item.icon}}-inactive"></view>
      <view class="iico iico-{{item.icon}}-active on"></view>
    </view>
    <text class="tab-text">{{item.text}}</text>
  </view>
</view>