@import "icons.wxss";

/* =========================================================
   全局设计变量 · 森林系描边卡片
   ========================================================= */
page {
  --primary: #839958;
  --primary-mid: #105666;
  --primary-light: rgba(131, 153, 88, 0.16);
  --alt-light: rgba(211, 150, 140, 0.18);
  --mid-light: rgba(16, 86, 102, 0.12);
  --cream: #f7f4d5;
  --stroke: #0a3323;
  --stroke-width: 3rpx;
  --text-main: #0a3323;
  --text-sub: #66756a;
  --text-light: #98a39b;
  --divider: rgba(10, 51, 35, 0.12);
  --radius-lg: 32rpx;
  --radius-md: 24rpx;
  --shadow-card: 0 6rpx 0 rgba(10, 51, 35, 0.10);
  --shadow-float: 0 10rpx 0 rgba(10, 51, 35, 0.16);

  background: #fdf9f5;
  color: var(--text-main);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

view,
text,
image,
input,
button,
scroll-view {
  box-sizing: border-box;
}

button::after {
  border: none;
}

/* 通用描边卡片 */
.card {
  margin: 24rpx;
  background: #fff;
  border: var(--stroke-width) solid var(--stroke);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}

/* 可点击元素统一按压反馈 */
.tap {
  transition: transform .12s ease, opacity .12s ease;
}
.tap:active {
  transform: scale(.96);
  opacity: .9;
}

/* 入场动画 */
@keyframes riseIn {
  from { opacity: 0; transform: translateY(12rpx); }
  to { opacity: 1; transform: translateY(0); }
}
.anim-rise {
  animation: riseIn .28s ease both;
}
.d-0 { animation-delay: 0s; }
.d-1 { animation-delay: .03s; }
.d-2 { animation-delay: .06s; }
.d-3 { animation-delay: .09s; }

/* 自定义 tabBar 底部占位 */
.tab-safe {
  height: calc(120rpx + env(safe-area-inset-bottom));
}

/* 企鹅 IP：各页面统一右下角悬浮 */
.penguin-float {
  position: fixed;
  right: 20rpx;
  bottom: calc(62rpx + env(safe-area-inset-bottom));
  z-index: 998;
  line-height: 0;
  pointer-events: auto;
}
